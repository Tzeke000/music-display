# Publisher credentials — copy to publisher/.env and fill on the LAPTOP.
# Never commit the real .env. Tokens obtained via `connect` are stored
# separately in publisher/.secrets/ (also gitignored).

# YouTube (Google Cloud OAuth client, type "Desktop")
YT_CLIENT_ID=
YT_CLIENT_SECRET=

# X / Twitter (developer portal app, OAuth 2.0)
X_CLIENT_ID=
X_CLIENT_SECRET=

# Instagram (Meta app + IG Business/Creator linked to a Facebook Page)
IG_USER_ID=
IG_TOKEN=

# TikTok (developer app, Content Posting API — requires audit)
TT_CLIENT_KEY=
TT_CLIENT_SECRET=
